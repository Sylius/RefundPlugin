<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="sylius_refund.checker.credit_memo_customer_relation" class="Sylius\RefundPlugin\Checker\CreditMemoCustomerRelationChecker">
            <argument type="service" id="sylius.context.customer"/>
            <argument type="service" id="sylius_refund.repository.credit_memo"/>
        </service>
        <service id="Sylius\RefundPlugin\Checker\CreditMemoCustomerRelationCheckerInterface" alias="sylius_refund.checker.credit_memo_customer_relation" />

        <service id="sylius_refund.checker.order_refunding_availability" class="Sylius\RefundPlugin\Checker\OrderRefundingAvailabilityChecker">
            <argument type="service" id="sylius.repository.order" />
            <argument type="service" id="sylius_abstraction.state_machine" />
        </service>

        <service id="sylius_refund.checker.order_refunds_list_availability" class="Sylius\RefundPlugin\Checker\OrderRefundsListAvailabilityChecker">
            <argument type="service" id="sylius.repository.order" />
            <argument type="service" id="sylius_refund.checker.order_refunding_availability" />
        </service>

        <service id="sylius_refund.checker.order_fully_refunded_total" class="Sylius\RefundPlugin\Checker\OrderFullyRefundedTotalChecker">
            <argument type="service" id="sylius_refund.provider.order_refunded_total" />
        </service>
        <service id="Sylius\RefundPlugin\Checker\OrderFullyRefundedTotalCheckerInterface" alias="sylius_refund.checker.order_fully_refunded_total" />

        <service id="sylius_refund.checker.unit_refunding_availability" class="Sylius\RefundPlugin\Checker\UnitRefundingAvailabilityChecker">
            <argument type="service" id="sylius_refund.provider.remaining_total" />
        </service>
        <service id="Sylius\RefundPlugin\Checker\UnitRefundingAvailabilityCheckerInterface" alias="sylius_refund.checker.unit_refunding_availability" />
    </services>
</container>
